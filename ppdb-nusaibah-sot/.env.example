# Application Environment Configuration Example
# Copy this file to .env and adjust variables for your local environment

APP_NAME="PPDB Pondok Pesantren Nusaibah Binti Kaab"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/ppdb-nusaibah-sot/public

# Database Configuration (MySQL / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppdb_nusaibah
DB_USERNAME=root
DB_PASSWORD=

# Upload Limits & Mime Types
UPLOAD_MAX_FILESIZE_KB=2048
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# Session
SESSION_LIFETIME=7200

